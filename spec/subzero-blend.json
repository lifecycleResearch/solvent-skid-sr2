  "assumptions": [
    {
      "id": "A-01",
      "text": "The carrier blend is 70 % ethanol and 30 % n-pentane by mass. The client named the blend but not the ratio.",
      "confirmed": false,
      "affects": [
        "OP-10",
        "OP-50",
        "S-206"
      ]
    },
    {
      "id": "A-02",
      "text": "CBD in the carrier drops to 0.12 % mass at -40 degC, a 75 % recovery of what was dissolved at 20 degC.",
      "confirmed": false,
      "affects": [
        "OP-30",
        "T-1"
      ]
    },
    {
      "id": "A-03",
      "text": "One tanker of carrier a week, 30 000 L, in 4 000 L extractions.",
      "confirmed": false,
      "affects": [
        "V-101",
        "N-2"
      ]
    },
    {
      "id": "A-04",
      "text": "Biomass is 25 % cannabinoids by mass and the extraction takes 90 % of them into the carrier.",
      "confirmed": false,
      "affects": [
        "OP-10",
        "S-202"
      ]
    },
    {
      "id": "A-05",
      "text": "The two stage vacuum set holds 8 mbar and boils the carrier at -10 degC, so the condenser runs on cascade coolant at -45 degC.",
      "confirmed": false,
      "affects": [
        "OP-50",
        "CN-101"
      ]
    }
  ]
