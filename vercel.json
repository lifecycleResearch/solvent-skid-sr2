{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'no dependencies to install'",
  "buildCommand": "echo 'the figure is built by the CI, not by Vercel'",
  "outputDirectory": "deploy/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/worker"
    },
    {
      "source": "/blend",
      "destination": "/blend.html"
    },
    {
      "source": "/skid",
      "destination": "/skid.html"
    }
  ]
}
