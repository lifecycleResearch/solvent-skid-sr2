              "neverError": true
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "9 · the bibliography",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -40,
        -160
      ],
      "notes": "BibTeX: the evidence a part rests on, ready to cite."
    },
    {
      "parameters": {
        "jsCode": "// The report: the grade, the gaps, the verdict, and what is open.\nconst grade = $('1 · check the specification reads').first().json;\nconst rubric = $('7 · the rubric judge').first().json.rubric || {};\nconst gaps = $('5 · the evidence gaps').first().json.gaps || [];\nconst questions = $('3 · the open questions').all();\nconst safety = $('7b · the safety questions').first().json;\nconst lines = [];\nlines.push(`# ${grade.verdict} — ${grade.passedCount}/${grade.total} deterministic checks`);\nif (rubric.score !== undefined) lines.push(`Rubric: ${(rubric.score * 100).toFixed(0)}% (pass mark ${((rubric.passMark || 0.75) * 100).toFixed(0)}%)`);\nlines.push('', '## The checks that are failing');\nfor (const c of grade.checks.filter((c) => !c.ok)) lines.push(`- ${c.name}: ${c.detail}`);\nlines.push('', '## The evidence gaps');\nfor (const g of gaps) lines.push(`- ${g.topic}: ${g.papers} papers, ${g.patents} patents`);\nlines.push('', '## The safety questions');\nfor (const q of safety.questions || []) lines.push(`- ${q.id} ${q.topic}: ${q.question} (owner: ${q.owner})`);\nlines.push('', '## The open questions');\nfor (const q of questions) for (const text of q.json.questions) lines.push(`- ${q.json.part}: ${text}`);\nreturn [{ json: { report: lines.join('\\n') } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000012",
      "name": "10 · the report",
      "type": "n8n-nodes-base.code",
