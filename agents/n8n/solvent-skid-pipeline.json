        "options": {
          "timeout": 180000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "7 · the rubric judge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        -340
      ],
      "notes": "The judgement on top of the checks. On Cloudflare this runs on Workers AI, so it needs no key. The verdict is per criterion."
