    {
      "parameters": {
        "method": "GET",
        "url": "https://solvent-skid-sr2.lifecyclerd.workers.dev/api/legitimacy?spec=blend",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "2 · the legitimacy register",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        200
      ],
      "notes": "What each component is built to, what applies to it, and what is still open. The open questions are the output."
    },
    {
      "parameters": {
        "jsCode": "// The gaps are the work: what is open, and what would close it.\nconst register = $input.all()[0].json;\nconst open = register.parts.filter((p) => p.openQuestions > 0);\nreturn open.map((p) => ({\n  part: p.id,\n  name: p.name,\n  questions: p.entries.filter((e) => e.kind === 'question' || e.strength === 'open').map((e) => e.question),\n}));"
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "3 · the open questions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://solvent-skid-sr2.lifecyclerd.workers.dev/api/evidence?spec=blend",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "4 · the evidence",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        20
      ],
      "notes": "The papers and the patents behind each part. A topic with nothing retrieved is a gap, not a failure."
    },
    {
      "parameters": {
        "jsCode": "// Which topics still have no patents, and how thin the papers are.\nconst evidence = $input.all()[0].json;\nconst rows = Object.entries(evidence.topics || {}).map(([id, t]) => ({\n  topic: id,\n  papers: (t.papers || []).length,\n  patents: (t.patents || []).length,\n  strength: t.strength,\n}));\nreturn [{ json: { rows, gaps: rows.filter((r) => !r.patents) } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "5 · the evidence gaps",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        20
      ]
    },
